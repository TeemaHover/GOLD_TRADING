# Copy to .env and fill in. NEVER commit .env.
# All secrets are read from the environment only - never from YAML config.

XAUBOT_DB_URL=sqlite:///data/xaubot.db
XAUBOT_LOG_LEVEL=INFO
XAUBOT_DATA_ROOT=D:/AI_BOT/data
XAUBOT_ARTIFACT_ROOT=D:/AI_BOT/artifacts

# Broker credentials - unused until Phase 14+. Live trading stays disabled.
XAUBOT_BROKER_API_KEY=
XAUBOT_BROKER_API_SECRET=
XAUBOT_BROKER_ACCOUNT_ID=
